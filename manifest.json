{
    "manifest_version": 2.0,
    "id": "network_topology",
    "name": "Network Topology for Zabbix",
    "version": "5.0.0",
    "author": "PlaNet Fox | Alexander Fox",
    "description": "Interactive network topology map with Cytoscape.js, clustering and severity filter",
    "namespace": "NetworkTopology",
    "actions": {
        "network.topology.view": {
            "class": "NetworkTopologyView",
            "view": "network.topology.view",
            "layout": "layout.htmlpage"
        },
        "network.topology.data": {
            "class": "NetworkTopologyData",
            "layout": "layout.json"
        },
        "network.topology.spark": {
            "class": "NetworkTopologySpark",
            "layout": "layout.json"
        },
        "network.topology.history": {
            "class": "NetworkTopologyHistory",
            "layout": "layout.json"
        },
        "network.topology.items": {
            "class": "NetworkTopologyItems",
            "layout": "layout.json"
        },
        "network.topology.discover_patterns": {
            "class": "NetworkTopologyDiscoverPatterns",
            "layout": "layout.json"
        },
        "network.topology.diag": {
            "class": "NetworkTopologyDiag",
            "layout": "layout.json"
        },
        "network.topology.compliance": {
            "class": "NetworkTopologyCompliance",
            "layout": "layout.json"
        },
        "network.topology.item_history": {
            "class": "NetworkTopologyItemHistory",
            "layout": "layout.json"
        },
        "network.topology.item_count": {
            "class": "NetworkTopologyItemCount",
            "layout": "layout.json"
        },
        "network.topology.capacity_forecast": {
            "class": "NetworkTopologyCapacityForecast",
            "layout": "layout.json"
        },
        "network.topology.health_history": {
            "class": "NetworkTopologyHealthHistory",
            "layout": "layout.json"
        },
        "network.topology.resource_forecast": {
            "class": "NetworkTopologyResourceForecast",
            "layout": "layout.json"
        },
        "network.topology.maintenance": {
            "class": "NetworkTopologyMaintenance",
            "layout": "layout.json"
        },
        "network.topology.links": {
            "class": "NetworkTopologyLinks",
            "layout": "layout.json"
        }
    }
}