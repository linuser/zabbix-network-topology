{
    "manifest_version": 2.0,
    "id": "network_topology_v6",
    "name": "Network Topology for Zabbix",
    "version": "4.35.4",
    "author": "PlaNet Fox | Alexander Fox",
    "description": "Interactive network topology map with Cytoscape.js, clustering and severity filter",
    "namespace": "NetworkTopologyV6",
    "actions": {
        "network.topology.v6.view": {
            "class": "NetworkTopologyView",
            "view": "network.topology.view",
            "layout": "layout.htmlpage"
        },
        "network.topology.v6.data": {
            "class": "NetworkTopologyData",
            "layout": "layout.json"
        },
        "network.topology.v6.spark": {
            "class": "NetworkTopologySpark",
            "layout": "layout.json"
        },
        "network.topology.v6.history": {
            "class": "NetworkTopologyHistory",
            "layout": "layout.json"
        },
        "network.topology.v6.items": {
            "class": "NetworkTopologyItems",
            "layout": "layout.json"
        },
        "network.topology.v6.discover_patterns": {
            "class": "NetworkTopologyDiscoverPatterns",
            "layout": "layout.json"
        },
        "network.topology.v6.diag": {
            "class": "NetworkTopologyDiag",
            "layout": "layout.json"
        },
        "network.topology.v6.compliance": {
            "class": "NetworkTopologyCompliance",
            "layout": "layout.json"
        },
        "network.topology.v6.item_history": {
            "class": "NetworkTopologyItemHistory",
            "layout": "layout.json"
        },
        "network.topology.v6.item_count": {
            "class": "NetworkTopologyItemCount",
            "layout": "layout.json"
        },
        "network.topology.v6.capacity_forecast": {
            "class": "NetworkTopologyCapacityForecast",
            "layout": "layout.json"
        },
        "network.topology.v6.health_history": {
            "class": "NetworkTopologyHealthHistory",
            "layout": "layout.json"
        },
        "network.topology.v6.resource_forecast": {
            "class": "NetworkTopologyResourceForecast",
            "layout": "layout.json"
        },
        "network.topology.v6.maintenance": {
            "class": "NetworkTopologyMaintenance",
            "layout": "layout.json"
        }
    }
}